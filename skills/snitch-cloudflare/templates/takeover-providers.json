[
  {
    "name": "AWS S3",
    "patterns": [
      "*.s3.amazonaws.com",
      "*.s3-website-*",
      "*.s3.dualstack.*.amazonaws.com",
      "*.s3-*.amazonaws.com",
      "*.s3.*.amazonaws.com"
