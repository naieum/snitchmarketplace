# RFC 9116 security.txt — https://datatracker.ietf.org/doc/html/rfc9116
# Place at: https://{{domain}}/.well-known/security.txt
# Optional: PGP-sign the file (clearsign) and reference the signing key in Encryption.
# Re-generate before Expires runs out — mailers and bug bounty tools reject expired files.

Contact: mailto:{{contact}}
Expires: {{expires}}
Encryption: {{encryption_url}}
Acknowledgments: {{ack_url}}
Preferred-Languages: en
Canonical: https://{{domain}}/.well-known/security.txt
Policy: {{policy_url}}
Hiring: {{hiring_url}}
