# TikTok Events API S2S — Python stub.
# Hashes PII with SHA-256, posts to /open_api/v1.3/event/track/.
#
# Env vars (NEVER commit):
#   TIKTOK_PIXEL_CODE
#   TIKTOK_ACCESS_TOKEN
#   TIKTOK_TEST_EVENT_CODE   optional

import hashlib
import os
import time
from typing import Any

import requests


def sha256(s: str) -> str:
    return hashlib.sha256((s or "").strip().lower().encode("utf-8")).hexdigest()


def send_tiktok_event(
    *,
    event: str,
    event_id: str | None,
    email: str | None = None,
    phone: str | None = None,
    external_id: str | None = None,
    ttclid: str | None = None,
    ttp: str | None = None,
    ip: str | None = None,
    user_agent: str | None = None,
    url: str | None = None,
    referrer: str | None = None,
    currency: str | None = None,
    value: float | None = None,
    contents: list | None = None,
    content_type: str | None = None,
    order_id: str | None = None,
) -> dict[str, Any]:
    pixel_code = os.environ["TIKTOK_PIXEL_CODE"]            # {{PLACEHOLDER}}
    access_token = os.environ["TIKTOK_ACCESS_TOKEN"]        # {{PLACEHOLDER}}
    test_code = os.environ.get("TIKTOK_TEST_EVENT_CODE")

    body = {
        "event_source": "web",
        "event_source_id": pixel_code,
        "data": [{
            "event": event,
            "event_time": int(time.time()),
            "event_id": event_id,
            "user": {
                "email": sha256(email) if email else None,
                "phone": sha256(phone) if phone else None,
                "external_id": sha256(external_id) if external_id else None,
                "ttclid": ttclid,
                "ttp": ttp,
                "ip": ip,
                "user_agent": user_agent,
            },
            "properties": {
                "currency": currency,
                "value": value,
                "contents": contents,
                "content_type": content_type,
                "order_id": order_id,
            },
            "page": {"url": url, "referrer": referrer},
        }],
    }
    if test_code:
        body["test_event_code"] = test_code

    r = requests.post(
        "https://business-api.tiktok.com/open_api/v1.3/event/track/",
        headers={"Access-Token": access_token, "Content-Type": "application/json"},
        json=body,
        timeout=5,
    )
    payload = r.json()
    if not r.ok or (payload.get("code") not in (0, None)):
        raise RuntimeError(f"TikTok Events API failed: {payload}")
    return payload


def handle_conversion(payload: dict) -> dict:
    return send_tiktok_event(
        event=payload.get("event", "CompletePayment"),
        event_id=payload.get("event_id"),
        email=payload.get("email"),
        phone=payload.get("phone"),
        external_id=payload.get("external_id"),
        ttclid=payload.get("ttclid"),
        ttp=payload.get("ttp"),
        ip=payload.get("ip"),
        user_agent=payload.get("user_agent"),
        url=payload.get("url"),
        referrer=payload.get("referrer"),
        currency=payload.get("currency"),
        value=payload.get("value"),
        contents=payload.get("contents"),
        content_type=payload.get("content_type"),
        order_id=payload.get("order_id"),
    )
