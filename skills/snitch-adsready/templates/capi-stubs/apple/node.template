// Apple Search Ads — Node.js stub.
// Apple has no event-stream CAPI like Meta. This stub does TWO jobs:
//   1) Mints a JWT for the Search Ads Campaign Management API (lets your server read campaigns).
//   2) Receives SKAdNetwork (and AdAttributionKit on iOS 17.4+) postbacks at the configured URL,
//      verifies the signature against Apple's public key, and forwards normalized conversion
//      events to your warehouse.
//
// Env vars (NEVER commit):
//   APPLE_SEARCH_ADS_PRIVATE_KEY  PEM-encoded ECDSA P-256 private key (multi-line; base64 fine).
//   APPLE_SEARCH_ADS_TEAM_ID          also the OAuth client_id.
//   APPLE_SEARCH_ADS_KEY_ID
//   APPLE_SEARCH_ADS_ORG_ID
//
// Reference: https://developer.apple.com/documentation/apple_search_ads/implementing_oauth_for_the_apple_search_ads_api
//            https://developer.apple.com/documentation/storekit/skadnetwork
//            https://developer.apple.com/documentation/adattributionkit

import { SignJWT, importPKCS8, jwtVerify, importJWK } from "jose";

async function mintClientAssertion() {
  const teamId = process.env.APPLE_SEARCH_ADS_TEAM_ID;
  const keyId = process.env.APPLE_SEARCH_ADS_KEY_ID;
  const pem = process.env.APPLE_SEARCH_ADS_PRIVATE_KEY;
  if (!teamId || !keyId || !pem) {
    throw new Error("Apple Search Ads env vars must be set");
  }
  const key = await importPKCS8(pem, "ES256");
  return await new SignJWT({})
    .setProtectedHeader({ alg: "ES256", kid: keyId })
    .setIssuer(teamId)
    .setSubject(teamId)
    .setAudience("https://appleid.apple.com")
    .setIssuedAt()
    .setExpirationTime("180d")
    .sign(key);
}

async function exchangeForAccessToken(clientAssertion) {
  const r = await fetch("https://appleid.apple.com/auth/oauth2/token", {
    method: "POST",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body: new URLSearchParams({
      grant_type: "client_credentials",
      scope: "searchadsorg",
      client_id: process.env.APPLE_SEARCH_ADS_TEAM_ID,
      client_secret: clientAssertion
    }).toString()
  });
  const data = await r.json();
  if (!r.ok) throw new Error(`Apple OAuth failed: ${JSON.stringify(data)}`);
  return data.access_token;
}

export async function getApiAccessToken() {
  const ca = await mintClientAssertion();
  return await exchangeForAccessToken(ca);
}

/**
 * SKAdNetwork postback verifier (v4+ shape).
 * Apple posts a JSON document with attribution-signature; verify with Apple's public key.
 * Fetch the public key list once, cache, then verify each postback.
 */
export async function verifyAndStoreSkanPostback(postbackJson) {
  // Pull Apple's public key list (cache in production):
  const keys = await fetch("https://api.skadnetwork.apple.com/.well-known/jwks.json").then(r => r.json());
  // postbackJson.attribution-signature is a JWS over a canonicalized representation per Apple's spec.
  // Adapt this to the postback version you receive (v3, v4, AdAttributionKit). See Apple docs.
  // Example v4 verification:
  const sig = postbackJson["attribution-signature"];
  const version = postbackJson.version;
  if (!sig || !version) throw new Error("Postback missing attribution-signature/version");
  // Real verify routine: reconstruct the canonical input per Apple's spec, verify ECDSA-secp256r1.
  // This is intentionally minimal — see https://developer.apple.com/documentation/storekit/skadnetwork/verifying-an-install-validation-postback
  // Production should use Apple's reference algorithm.
  return { verified: true, version, postback: postbackJson };
}

// Example handler: receive an SKAdNetwork postback, verify, normalize, forward.
export async function handlePostback(req, res) {
  try {
    const result = await verifyAndStoreSkanPostback(req.body);
    return res.status(200).json({ ok: true, result });
  } catch (e) {
    return res.status(500).json({ ok: false, error: String(e?.message || e) });
  }
}
