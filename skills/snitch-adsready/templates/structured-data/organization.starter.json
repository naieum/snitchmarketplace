{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "{{SITE_URL}}/#organization",
  "name": "{{ORG_NAME}}",
  "url": "{{SITE_URL}}",
  "logo": {
    "@type": "ImageObject",
    "@id": "{{SITE_URL}}/#logo",
    "url": "{{LOGO_URL}}",
    "contentUrl": "{{LOGO_URL}}",
    "width": 512,
    "height": 512,
    "caption": "{{ORG_NAME}}"
  },
  "image": { "@id": "{{SITE_URL}}/#logo" },
  "description": "{{ORG_DESCRIPTION}}",
  "founder": "{{FOUNDER_NAME}}",
  "foundingDate": "{{FOUNDING_DATE}}",
  "email": "{{ORG_EMAIL}}",
  "telephone": "{{ORG_PHONE}}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{STREET}}",
    "addressLocality": "{{CITY}}",
    "addressRegion": "{{REGION}}",
    "postalCode": "{{POSTAL_CODE}}",
    "addressCountry": "{{COUNTRY_ISO}}"
  },
  "sameAs": [
    "{{LINKEDIN_URL}}",
    "{{X_URL}}",
    "{{FACEBOOK_URL}}",
    "{{INSTAGRAM_URL}}",
    "{{YOUTUBE_URL}}",
    "{{GITHUB_URL}}"
  ],
  "contactPoint": [{
    "@type": "ContactPoint",
    "contactType": "customer service",
    "email": "{{SUPPORT_EMAIL}}",
    "availableLanguage": ["en"]
  }]
}
