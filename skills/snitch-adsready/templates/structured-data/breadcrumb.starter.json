{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{SITE_URL}}"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{CATEGORY_NAME}}",
      "item": "{{SITE_URL}}/{{CATEGORY_SLUG}}"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{PAGE_NAME}}"
    }
  ]
}
