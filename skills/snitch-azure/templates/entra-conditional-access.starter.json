{
  "_comment": "Starter Microsoft Entra Conditional Access policies. These are JSON shapes Claude can adapt for the user, NOT a runnable script. Apply via Microsoft Graph PowerShell or az rest after the user reviews.",
  "policies": [
    {
      "displayName": "Require MFA for all admins",
      "state": "enabledForReportingButNotEnforced",
      "conditions": {
        "users": {
          "includeRoles": [
            "62e90394-69f5-4237-9190-012177145e10",
            "194ae4cb-b126-40b2-bd5b-6091b380977d",
            "f28a1f50-f6e7-4571-818b-6a12f2af6b6c"
          ]
        },
        "applications": { "includeApplications": ["All"] },
        "clientAppTypes": ["all"]
      },
      "grantControls": {
        "operator": "OR",
        "builtInControls": ["mfa"]
      }
    },
    {
      "displayName": "Block legacy authentication",
      "state": "enabledForReportingButNotEnforced",
      "conditions": {
        "users": { "includeUsers": ["All"] },
        "applications": { "includeApplications": ["All"] },
        "clientAppTypes": ["exchangeActiveSync", "other"]
      },
      "grantControls": {
        "operator": "OR",
        "builtInControls": ["block"]
      }
    },
    {
      "displayName": "Require compliant device for high-risk sign-ins",
      "state": "enabledForReportingButNotEnforced",
      "conditions": {
        "users": { "includeUsers": ["All"] },
        "applications": { "includeApplications": ["All"] },
        "signInRiskLevels": ["high", "medium"]
      },
      "grantControls": {
        "operator": "OR",
        "builtInControls": ["compliantDevice", "domainJoinedDevice"]
      }
    }
  ]
}
